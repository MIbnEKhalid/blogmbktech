    "dompurify": "^3.3.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "express-rate-limit": "^8.7.0",
    "jsdom": "^26.1.0",
    "marked": "^18.0.14",
    "mbkauthe": "file:../mbkauthe",
    "mbkbucket": "file:../mbkbucket",
