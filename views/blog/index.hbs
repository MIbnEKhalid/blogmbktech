{{> partials/homeMetaData}}
<div class="section-container">
    {{> partials/searchAndFilter}}

    {{#if posts.length}}
    <div class="posts-grid" id="postsGrid">
        {{#each posts}}
        {{> partials/postCard}}
        {{/each}}
    </div>

    {{> partials/pagination}}
    {{else}}
    <div class="empty-state">
        <h2>No posts found</h2>
        <p>Be the first to create a post!</p>
        {{#if user}}
        <a href="/dashboard/posts/create" class="btn btn-primary">Create New Post</a>
        {{else}}
        <a href="/mbkauthe/login" class="btn btn-primary">Login to Post</a>
        {{/if}}
    </div>
    {{/if}}
</div>

{{> partials/searchAndFilterScript}}
